# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle's own output tree. `/build/` above anchors to the repo root, so it does
# NOT cover this one -- a local `flutter build apk` drops ~1GB here and it was
# staged for commit before anyone noticed.
/android/build/
/android/.gradle/

# Release signing — never commit the upload keystore or its passwords.
# CI decodes KEYSTORE_BASE64 (a GitHub Actions secret) into these same paths
# at build time; see .github/workflows/release-apk.yml.
*.jks
*.keystore
key.properties

# iOS release signing (Fastlane Match / App Store Connect).
ios/fastlane/apikey.json
ios/AuthKey.p8
ios/fastlane/report.xml

# Local-only credentials notes generated while setting up release signing —
# deliberately never committed. See RELEASE_SECRETS.local.md's own header.
RELEASE_SECRETS.local.md
scripts/gates/__pycache__/
scripts/gates/**/__pycache__/

# Skills export for download — never committed (asked for explicitly, 2026-08-29).
kudimata-skills-*.zip

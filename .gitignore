# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — never commit the upload keystore or its passwords.
# CI decodes KEYSTORE_BASE64 (a GitHub Actions secret) into these same paths
# at build time; see .github/workflows/release-apk.yml.
*.jks
*.keystore
key.properties

# iOS release signing (Fastlane Match / App Store Connect).
ios/fastlane/apikey.json
ios/AuthKey.p8
ios/fastlane/report.xml

# Local-only credentials notes generated while setting up release signing —
# deliberately never committed. See RELEASE_SECRETS.local.md's own header.
RELEASE_SECRETS.local.md

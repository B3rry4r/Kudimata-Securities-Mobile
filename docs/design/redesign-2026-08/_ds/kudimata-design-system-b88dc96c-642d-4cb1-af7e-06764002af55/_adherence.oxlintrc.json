{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/comprehension/**",
              "components/core/**",
              "components/data/**",
              "components/email/**",
              "components/feedback/**",
              "components/finance/**",
              "components/forms/**",
              "components/icons/**",
              "components/illustration/**",
              "components/layout/**",
              "components/mobile/**",
              "components/navigation/**",
              "components/security/**",
              "ui_kits/admin-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Nunito, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|guideSrc|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<AIMark> doesn't accept that prop. Declared props: label, size, guideSrc, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|color|key|ref|className|style|children)$/]",
        "message": "<DonutSegment> doesn't accept that prop. Declared props: value, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|ticker|logoColor|price|change|trend|sparkline|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AssetRow> doesn't accept that prop. Declared props: name, ticker, logoColor, price, change, trend, sparkline, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetRow'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:gain|loss)$/]",
        "message": "<AssetRow> trend must be one of 'gain' | 'loss'."
